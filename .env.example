# Google Apps Script Web App URL that appends rows to the Deeksharambh 2026 - DCL Registrations sheet.
# Created via: Extensions -> Apps Script -> Deploy -> New deployment -> Web app
# (Execute as: Me, Who has access: Anyone). Copy the /exec URL here.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXX/exec

# Google Apps Script Web App URL for the SEPARATE Deeksharambh 2026 - DCL Submissions sheet.
# Same setup process on the submissions spreadsheet (own deployment, own /exec URL).
SUBMISSION_SCRIPT_URL=https://script.google.com/macros/s/YYYYYYY/exec
